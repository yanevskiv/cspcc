-- (Test) Arguments: --delay=0
-- (Test) Output:
-- | R: print(true)
-- Among inputs whose senders wait, one is chosen at random, so no sender is starved;
-- R counts to 100000 after each input, so that every sender waits again.

[ S(i:1..3):: [ k: integer; k := 0; *[ k < 200 -> [ R!k; k := k + 1 ] ] ]
|| R:: [ count: (1..3) integer; total, v, j: integer;
         count(1) := 0; count(2) := 0; count(3) := 0; total := 0;
         *[ (i:1..3) S(i)?v -> [ count(i) := count(i) + 1; total := total + 1;
                                 j := 0; *[ j < 100000 -> j := j + 1 ];
                                 [ total = 300 -> print(count(1) > 50 and count(2) > 50 and count(3) > 50)
                                 [] total <> 300 -> skip ] ] ] ] ]
