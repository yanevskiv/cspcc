-- (Test) Arguments: --delay=0
-- (Test) Output:
-- | X: negative()
-- | X: zero()
-- | X: positive()
-- An alternative command runs the commands of a guard that is true.

X:: [ n: integer; n := -1;
      *[ n < 2 -> [ [ n < 0 -> negative() [] n = 0 -> zero() [] n > 0 -> positive() ]; n := n + 1 ] ] ]
