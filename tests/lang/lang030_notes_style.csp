-- (Test) Arguments: --delay=0
-- (Test) Sorted output:
-- | Sender(1): sent(1)
-- | Sender(2): sent(2)
-- | Echo(1): ECHOING
-- | Echo(2): ECHOING
-- | Receiver: print(3)
-- The notes' style: NAME :: value, (i:1..N) Name(i) :: BODY, Name(1..N), Integer,
-- commas in guards, -> [ ... ] bodies and /* */ comments.

N :: 2

/* Senders send their number,
   the receiver adds them up. */
[
    (i:1..N) Sender(i) :: SENDER
 || Echo(1..N) :: ECHO
 || Receiver :: RECEIVER
]

SENDER :: [
    Receiver!value(i);
    sent(i);
]

ECHO :: ECHOING;

RECEIVER :: [
    sum, k, v : Integer;
    sum := 0;
    k := 0;
    *[
        k < N, (i:1..N) Sender(i)?value(v) -> [
            sum := sum + v;
            k := k + 1;
        ]
    ];
    print(sum);
]
