-- (Test) Arguments: --delay=0
-- (Test) Output:
-- | X: small(1)
-- | X: middle(2)
-- | X: large(3)
-- The box spelled □, [] and |, also at the start of a line.

X:: [ n: integer; n := 1;
      *[ n > 0 and n <= 3 ->
           [ n = 1 -> small(n)
           [] n = 2 -> middle(n)
           |  n = 3 -> large(n)
           ];
           n := n + 1
       □ n = 4 -> n := 10
       [] n = 10 -> skip; n := -1
       ] ]
