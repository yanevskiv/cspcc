#!/bin/sh
# santa_claus - check that Santa rewards all reindeer after delivering toys and dismisses
# elves three at a time after helping them, from --trace output.
awk '
    /^Santa: DELIVER_TOYS end/ { want = "reward()"; left = 9; deliveries++; next }
    /^Santa: HELP_ELVES end/ { want = "done()"; left = 3; helps++; next }
    /^Santa: / { if (left != 0) { print "unfinished round before: " $0; bad = 1 } next }
    /^Santa -> / {
        if (left == 0 || index($0, want) == 0) { print "unexpected: " $0; bad = 1 }
        left--
    }
    END { if (deliveries == 0 || helps == 0) { print "Santa delivered " deliveries + 0 " and helped " helps + 0; exit 1 } exit bad }
' "$1"
