#!/bin/sh
# readers_writers - check that a writer writes alone and readers read together, from --trace output.
awk '
    index($0, ": READING end") { readers--; next }
    index($0, ": WRITING end") { writers--; next }
    index($0, ": READING") { readers++; reads++; if (writers > 0) { print "read while writing: " $0; bad = 1 } }
    index($0, ": WRITING") { writers++; writes++; if (writers > 1 || readers > 0) { print "write not alone: " $0; bad = 1 } }
    END { if (reads == 0) { print "nobody read"; exit 1 } exit bad }
' "$1"
