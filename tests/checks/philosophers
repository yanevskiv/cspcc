#!/bin/sh
# philosophers - check, from --trace output, that neighbors never eat at once and all eat.
awk '
    match($1, /^Phil\(([0-9]+)\):$/, m) {
        p = m[1]
        if ($2 == "EAT" && $3 == "end") { eating[p] = 0; next }
        if ($2 == "EAT") {
            if (eating[(p + 4) % 5] || eating[(p + 1) % 5]) { print "neighbors eat: " p; bad = 1 }
            eating[p] = 1; meals[p]++
        }
    }
    END { for (p = 0; p < 5; p++) if (!meals[p]) { print "Phil(" p ") never ate"; bad = 1 } exit bad }
' "$1"
