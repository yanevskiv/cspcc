-- The slides' recursive factorial as a chain of processes, fac(1) to fac(LIMIT).
-- USER asks fac(1) for N!, and the chain ends once USER does.

LIMIT :: 10
N :: 5

[
    (i:1..LIMIT) fac(i) :: FAC
 || fac(0) :: USER
]

FAC :: *[
    n : Integer; fac(i - 1)?n -> [
        [
                n = 0 -> [
                    fac(i - 1)!1;
                ]
            []  n > 0 -> [
                    r : Integer;
                    fac(i + 1)!n - 1;
                    fac(i + 1)?r;
                    fac(i - 1)!(n * r);
                ]
        ]
    ]
]

USER :: [
    r : Integer;
    fac(1)!N;
    fac(1)?r;
    print(r);
]
