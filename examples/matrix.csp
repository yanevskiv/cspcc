-- The slides' multiplication of vectors by a fixed 3x3 matrix A on a grid of processes.
-- WEST feeds V vectors, row i getting element i, and SOUTH prints the products' elements.

const V = 2

[ M(i:1..3, 0)::WEST || M(0, j:1..3)::NORTH || M(i:1..3, 4)::EAST
|| M(4, j:1..3)::SOUTH || M(i:1..3, j:1..3)::CENTER ]

WEST:: [ k: integer; k := 1; *[ k <= V → [ M(i, 1)!(i + k); k := k + 1 ] ] ]
NORTH:: [ k: integer; k := 0; *[ k < V → [ M(1, j)!0; k := k + 1 ] ] ]
EAST:: *[ x: integer; M(i, 3)?x → skip ]
SOUTH:: *[ sum: integer; M(3, j)?sum → print(sum) ]

CENTER:: [ A: (1..3, 1..3) integer; INIT;
  *[ x: integer; M(i, j - 1)?x → [
       M(i, j + 1)!x;
       sum: integer;
       M(i - 1, j)?sum;
       M(i + 1, j)!(A(i, j) * x + sum) ] ] ]

INIT:: [ A(1, 1) := 1; A(1, 2) := 2; A(1, 3) := 3;
         A(2, 1) := 4; A(2, 2) := 5; A(2, 3) := 6;
         A(3, 1) := 7; A(3, 2) := 8; A(3, 3) := 9 ]
