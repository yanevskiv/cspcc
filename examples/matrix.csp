-- The slides' multiplication of vectors by a fixed 3x3 matrix A on a grid of processes.
-- WEST feeds V vectors, row i getting element i, and SOUTH prints the products' elements.

V :: 2

[
    (i:1..3) M(i, 0) :: WEST
 || (j:1..3) M(0, j) :: NORTH
 || (i:1..3) M(i, 4) :: EAST
 || (j:1..3) M(4, j) :: SOUTH
 || (i:1..3, j:1..3) M(i, j) :: CENTER
]

WEST :: [
    k : Integer;
    k := 1;
    *[
        k <= V -> [
            M(i, 1)!(i + k);
            k := k + 1;
        ]
    ]
]

NORTH :: [
    k : Integer;
    k := 0;
    *[
        k < V -> [
            M(1, j)!0;
            k := k + 1;
        ]
    ]
]

EAST :: *[
    x : Integer; M(i, 3)?x -> [
        skip;
    ]
]

SOUTH :: *[
    sum : Integer; M(3, j)?sum -> [
        print(sum);
    ]
]

CENTER :: [
    A : (1..3, 1..3) Integer;
    A(1, 1) := 1; A(1, 2) := 2; A(1, 3) := 3;
    A(2, 1) := 4; A(2, 2) := 5; A(2, 3) := 6;
    A(3, 1) := 7; A(3, 2) := 8; A(3, 3) := 9;
    *[
        x : Integer; M(i, j - 1)?x -> [
            sum : Integer;
            M(i, j + 1)!x;
            M(i - 1, j)?sum;
            M(i + 1, j)!(A(i, j) * x + sum);
        ]
    ]
]
