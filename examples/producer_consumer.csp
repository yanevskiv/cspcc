-- The slides' bounded buffer of 10 portions between 5 producers and 6 consumers.
-- Each producer makes 6 portions and each consumer takes 5, so every process ends.

[
    (i:1..5) Producer(i) :: PRODUCER
 || (i:1..6) Consumer(i) :: CONSUMER
 || Buffer :: BUFFER
]

PRODUCER :: [
    k, data : Integer;
    k := 0;
    *[
        k < 6 -> [
            data := i * 100 + k;
            Buffer!data;
            k := k + 1;
        ]
    ]
]

CONSUMER :: [
    k, data : Integer;
    k := 0;
    *[
        k < 5 -> [
            Buffer!more();
            Buffer?data;
            consume(data);
            k := k + 1;
        ]
    ]
]

BUFFER :: [
    buffer : (0..9) Integer;
    in, out : Integer;
    in := 0;
    out := 0;
    *[
            in < out + 10, (i:1..5) Producer(i)?buffer(in mod 10) -> [
                in := in + 1;
            ]
        []  out < in, (i:1..6) Consumer(i)?more() -> [
                Consumer(i)!buffer(out mod 10);
                out := out + 1;
            ]
    ]
]
