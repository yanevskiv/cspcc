-- X copies characters from west to east, turning each ** into ^.
-- As on the slides, the last character isn't a star.

[
    west :: WEST
 || X :: SQUASH
 || east :: EAST
]

WEST :: [
    X!'a'; X!'*'; X!'*'; X!'b'; X!'*'; X!'c';
    X!'*'; X!'*'; X!'*'; X!'*'; X!'d';
]

SQUASH :: *[
    c : Character; west?c -> [
        [
                c <> '*' -> [
                    east!c;
                ]
            []  c = '*' -> [
                    west?c;
                    [
                            c <> '*' -> [
                                east!'*';
                                east!c;
                            ]
                        []  c = '*' -> [
                                east!'^';
                            ]
                    ]
                ]
        ]
    ]
]

EAST :: *[
    c : Character; X?c -> [
        print(c);
    ]
]
