-- The slides' first program: X copies characters from west to east.

[
    west :: WEST
 || X :: COPY
 || east :: EAST
]

WEST :: [
    X!'h';
    X!'e';
    X!'l';
    X!'l';
    X!'o';
]

COPY :: *[
    c : Character; west?c -> [
        east!c;
    ]
]

EAST :: *[
    c : Character; X?c -> [
        print(c);
    ]
]
