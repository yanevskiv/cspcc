-- The set of the slides extended with scan(), which lists every element.

S:: [ content: (0..99) integer; size: integer; size := 0; n: integer;
  *[ X?has(n) → [ SEARCH; X!(i < size) ]
   □ X?insert(n) → [ SEARCH;
                     [ i < size → skip
                     □ i = size; size < 100 → [ content(size) := n; size := size + 1 ] ] ]
   □ X?scan() → [ i: integer; i := 0;
                  *[ i < size → [ X!next(content(i)); i := i + 1 ] ];
                  X!noneleft() ] ] ]

SEARCH:: [ i: integer; i := 0; *[ i < size; content(i) <> n → i := i + 1 ] ]

X:: [ b: boolean;
      S!insert(7); S!insert(2); S!insert(7); S!insert(9);
      S!has(2); S?b; print(2, b);
      S!scan(); more: boolean; more := true;
      *[ more; x: integer; S?next(x) → print(x)
       □ more; S?noneleft() → more := false ] ]
